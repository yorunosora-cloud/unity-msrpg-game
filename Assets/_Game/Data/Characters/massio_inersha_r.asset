  concept: "\uC9C0\uD0AC \uC564 \uD558\uC774\uB4DC \uCF58\uC149\uD2B8\uC758 \uAE30\uC0AC.
    \uC5C4\uADFC\uC9C4 \uAE30\uC0AC(\uB9C8\uC2DC\uC624) \u2194 \uB2E4\uD608\uC9C8
    \uC804\uD22C\uAD11(\uC774\uB124\uB974\uC154)"
  appearance: "\uB9C8\uC2DC\uC624(\uC5EC\uC131): \uC911\uC138 \uAE30\uC0AC \uAC11\uC637,
    \uAE54\uB054\uD55C \uB9DD\uD1A0(\uB274\uD134 \uC81C\uAD6D \uD30C\uB791 \uBC14\uD0D5\uC5D0
    \uC0AC\uACFC\xB7\uD3EC\uBB3C\uC120 \uADA4\uC801 \uBB38\uC591), \uAE08\uBC1C,
    \uB179\uC548, \uC5B4\uB450\uC6B4 \uB208\uBE5B, \uC9C4\uC9C0\uD55C \uD45C\uC815.
    / \uC774\uB124\uB974\uC154(\uB0A8\uC131): \uAC00\uBCBC\uC6B4 \uC637, \uBD89\uC740
    \uCC22\uC5B4\uC9C4 \uB9DD\uD1A0, \uAC00\uC8FD \uBD80\uCE20, \uC801\uBC1C, \uD751\uC548,
    \uB0A0\uCE74\uB85C\uC6B4 \uC774\uBE68, \uB208\uC5D0 \uD749\uD130."
  weapon: "\uB9C8\uC2DC\uC624 \u2014 \uB290\uB9AC\uC9C0\uB9CC \uAC15\uB825\uD55C
    \uB300\uAC80 / \uC774\uB124\uB974\uC154 \u2014 \uBE60\uB974\uACE0 \uBB35\uC9C1\uD55C
    \uB300\uB3C4"
  loreKo: "\uD3C9\uC18C\uC5D4 \uC5C4\uACA9\uD558\uACE0 \uC2E0\uC0AC\uC801\uC778 \uC81C\uAD6D
    \uAE30\uC0AC \uB9C8\uC2DC\uC624\uC774\uC9C0\uB9CC, \uD55C \uBC88 \uC6C0\uC9C1\uC784\uC774
    \uC2DC\uC791\uB418\uBA74 \uB2E4\uD608\uC9C8\uC758 \uC804\uD22C\uAD11 \uC774\uB124\uB974\uC154\uAC00
