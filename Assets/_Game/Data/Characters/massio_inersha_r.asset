  personality: "\uC9C0\uD0AC \uC564 \uD558\uC774\uB4DC. \uB9C8\uC2DC\uC624\uC77C
    \uB550 \uC5C4\uACA9\uD558\uACE0 \uC9C4\uC9C0\uD55C \uC2E0\uC0AC\uC801 \uAE30\uC0AC,
    \uC774\uB124\uB974\uC154\uC77C \uB550 \uB2E4\uD608\uC9C8\uC758 \uC804\uD22C\uAD11"
  basicAttackMotion: "\uB9C8\uC2DC\uC624 \u2014 \uB290\uB9AC\uACE0 \uBB35\uC9C1\uD55C
    \uB300\uAC80 \uD718\uB450\uB974\uAE30 / \uC774\uB124\uB974\uC154 \u2014 \uBE60\uB974\uACE0
    \uAC70\uCE5C \uB300\uB3C4 \uD718\uB450\uB974\uAE30"
  basicExplanation: "\uAD00\uC131\uC740 \uBB3C\uCCB4\uAC00 \uD604\uC7AC\uC758 \uC6B4\uB3D9
    \uC0C1\uD0DC(\uC815\uC9C0 \uB610\uB294 \uB4F1\uC18D \uC9C1\uC120 \uC6B4\uB3D9)\uB97C
    \uACC4\uC18D \uC720\uC9C0\uD558\uB824\uB294 \uC131\uC9C8\uC774\uB2E4. \uC9C8\uB7C9\uC774
    \uD074\uC218\uB85D \uAD00\uC131\uC774 \uD06C\uB2E4. \uB274\uD134 \uC81C1\uBC95\uCE59\uC744
    \uAD00\uC131\uC758 \uBC95\uCE59\uC774\uB77C\uACE0\uB3C4 \uD55C\uB2E4."
  advancedExplanation: "\uC9C8\uB7C9\uC740 \uAD00\uC131\uC758 \uD06C\uAE30\uB97C
    \uB098\uD0C0\uB0B4\uB294 \uC591\uC774\uB2E4. \uAC19\uC740 \uD798\uC744 \uAC00\uD574\uB3C4
    \uC9C8\uB7C9\uC774 \uD074\uC218\uB85D \uAC00\uC18D\uB3C4\uAC00 \uC791\uB2E4(a
    = F/m). \uB2EC\uB9AC\uB358 \uBC84\uC2A4\uAC00 \uAE09\uC815\uAC70\uD558\uBA74
    \uBAB8\uC774 \uC55E\uC73C\uB85C \uC3E0\uB9AC\uB294 \uAC83\uC740, \uBAB8\uC774
    \uC6D0\uB798\uC758 \uC6B4\uB3D9 \uC0C1\uD0DC\uB97C \uACC4\uC18D \uC720\uC9C0\uD558\uB824
    \uD558\uAE30 \uB54C\uBB38\uC774\uB2E4. \uC9C8\uB7C9\uC740 \uC7A5\uC18C\uAC00
    \uBC14\uB00C\uC5B4\uB3C4 \uBCC0\uD558\uC9C0 \uC54A\uC9C0\uB9CC \uBB34\uAC8C(\uC911\uB825\uC758
    \uD06C\uAE30)\uB294 \uB2EC\uB77C\uC9C4\uB2E4."
  realPrinciple: "\uB274\uD134 \uC81C1\uBC95\uCE59: \uBB3C\uCCB4\uC5D0 \uC791\uC6A9\uD558\uB294
    \uC54C\uC9DC\uD798\uC774 0\uC774\uBA74 \uC815\uC9C0\uD55C \uBB3C\uCCB4\uB294
    \uACC4\uC18D \uC815\uC9C0\uD574 \uC788\uACE0, \uC6B4\uB3D9\uD558\uB294 \uBB3C\uCCB4\uB294
    \uB4F1\uC18D \uC9C1\uC120 \uC6B4\uB3D9\uC744 \uACC4\uC18D\uD55C\uB2E4."
  sourceRef: "\uC911\uD559\uAD50 \uACFC\uD559 \u2014 \uD798\uACFC \uC6B4\uB3D9(\uB274\uD134
    \uC81C1\uBC95\uCE59, \uAD00\uC131)"
  conceptQuestions:
  - question: "\uB2EC\uB9AC\uB358 \uBC84\uC2A4\uAC00 \uAC11\uC790\uAE30 \uBA48\uCD9C
      \uB54C \uC2B9\uAC1D\uC758 \uBAB8\uC774 \uC55E\uC73C\uB85C \uC3E0\uB9AC\uB294
      \uAE4C\uB2ED\uC740?"
    choices:
    - "\uC2B9\uAC1D\uC5D0\uAC8C \uC55E\uCABD\uC73C\uB85C \uD798\uC774 \uC791\uC6A9\uD558\uAE30
      \uB54C\uBB38\uC774\uB2E4"
    - "\uC2B9\uAC1D\uC774 \uC6D0\uB798\uC758 \uC6B4\uB3D9 \uC0C1\uD0DC\uB97C \uC720\uC9C0\uD558\uB824\uB294
      \uAD00\uC131 \uB54C\uBB38\uC774\uB2E4"
    - "\uBC84\uC2A4\uAC00 \uC2B9\uAC1D\uC744 \uC55E\uC73C\uB85C \uBC00\uAE30 \uB54C\uBB38\uC774\uB2E4"
    - "\uC911\uB825\uC758 \uBC29\uD5A5\uC774 \uC55E\uCABD\uC73C\uB85C \uBC14\uB00C\uAE30
      \uB54C\uBB38\uC774\uB2E4"
    answerIndex: 1
  affinityQuestions:
  - question: "\uAD00\uC131\uC758 \uBC95\uCE59\uC740 \uC5B4\uB5A4 \uBB3C\uCCB4\uC5D0
      \uC801\uC6A9\uB420\uAE4C?"
    choices:
    - "\uC815\uC9C0\uD55C \uBB3C\uCCB4\uC640 \uC6C0\uC9C1\uC774\uB294 \uBB3C\uCCB4
      \uBAA8\uB450\uC5D0 \uC801\uC6A9\uB41C\uB2E4"
    - "\uC6C0\uC9C1\uC774\uB294 \uBB3C\uCCB4\uC5D0\uB9CC \uC801\uC6A9\uB41C\uB2E4"
    conceptPick: 0
  portraitColor: {r: 1, g: 1, b: 1, a: 1}
