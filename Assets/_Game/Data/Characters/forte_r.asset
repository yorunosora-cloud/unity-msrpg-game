  concept: "\uAC70\uB300\uD55C \uC11D\uC0C1 \uD0C0\uC774\uD0C4. \uD798\uC774\uB77C\uB294
    \uAC1C\uB150 \uADF8 \uC790\uCCB4\uB97C \uBAB8\uC73C\uB85C \uAD6C\uD604\uD55C
    \uAC70\uC778"
  appearance: "\uC628\uBAB8\uC774 \uC554\uC11D\xB7\uAD11\uBB3C\uC9C8 \uC9C8\uAC10\uC758
    \uAC70\uC778 \uCCB4\uAD6C. \uC5EC\uB7EC \uD798\uC758 \uBC29\uD5A5\uC744 \uBCF4\uC5EC\uC8FC\uB294
    \uD654\uC0B4\uD45C \uBB38\uC591\uC774 \uD53C\uBD80\uC5D0 \uC0C8\uACA8\uC9D0.
    \uB9E8\uC190\uC73C\uB85C \uC801\uC744 \uB9C9\uC544\uC11C\uB294 \uAC70\uB300\uD55C
    \uBC29\uD328 \uAC19\uC740 \uC874\uC7AC\uAC10"
  weapon: "\uB9E8\uBAB8(\uAC70\uB300\uD55C \uC8FC\uBA39\uACFC \uBAB8 \uC790\uCCB4\uAC00
    \uBB34\uAE30)"
  loreKo: "\uC5EC\uB7EC \uD798\uC758 \uBC29\uD5A5\uC774 \uC0C8\uACA8\uC9C4 \uAC70\uB300\uD55C
    \uC11D\uC0C1 \uD0C0\uC774\uD0C4\uC73C\uB85C, \uB9D0\uC5C6\uC774 \uB9E8\uBAB8\uC73C\uB85C
    \uB3D9\uB8CC \uC55E\uC744 \uB9C9\uC544\uC120\uB2E4. \uADF8\uAC00 \uC6C0\uC9C1\uC774\uBA74
    \uB300\uC9C0\uAC00 \uD568\uAED8 \uBC18\uC751\uD55C\uB2E4\uACE0 \uD55C\uB2E4."
