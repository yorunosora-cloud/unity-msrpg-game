  personality: "\uB9D0\uC218\uAC00 \uC801\uC740 \uBB35\uBB35\uD55C \uC218\uD638\uC790\uD615"
  basicAttackMotion: "\uAC70\uB300\uD55C \uC8FC\uBA39\uC73C\uB85C \uB0B4\uB9AC\uCC0D\uB294
    \uB3D9\uC791"
  basicExplanation: "\uD798\uC740 \uBB3C\uCCB4\uC758 \uBAA8\uC591\uC774\uB098 \uC6B4\uB3D9
    \uC0C1\uD0DC\uB97C \uBC14\uAFB8\uB294 \uC6D0\uC778\uC774\uB2E4. \uD06C\uAE30\uC640
    \uBC29\uD5A5\uC744 \uBAA8\uB450 \uAC00\uC9C0\uBA70 \uB2E8\uC704\uB294 N(\uB274\uD134)\uC774\uB2E4.
    \uC77C\uC0C1\uC5D0\uC11C \uB9CC\uB098\uB294 \uD798\uC5D0\uB294 \uC911\uB825,
    \uB9C8\uCC30\uB825, \uC218\uC9C1\uD56D\uB825, \uD0C4\uC131\uB825, \uBD80\uB825
    \uB4F1\uC774 \uC788\uB2E4."
  advancedExplanation: "\uD55C \uBB3C\uCCB4\uC5D0 \uC5EC\uB7EC \uD798\uC774 \uC791\uC6A9\uD558\uBA74
    \uBCA1\uD130\uB85C \uB354\uD55C \uD569\uB825\uC744 \uAD6C\uD55C\uB2E4. \uD569\uB825\uC774
    0\uC774\uBA74 \uBB3C\uCCB4\uB294 \uC815\uC9C0\uD574 \uC788\uAC70\uB098 \uB4F1\uC18D
    \uC9C1\uC120 \uC6B4\uB3D9\uC744 \uD558\uACE0(\uD798\uC758 \uD3C9\uD615), 0\uC774
    \uC544\uB2C8\uBA74 F = ma\uC5D0 \uB530\uB77C \uD569\uB825 \uBC29\uD5A5\uC73C\uB85C
    \uAC00\uC18D\uB3C4\uAC00 \uC0DD\uAE34\uB2E4. \uC791\uC6A9\xB7\uBC18\uC791\uC6A9\uC740
    \uD06C\uAE30\uAC00 \uAC19\uACE0 \uBC29\uD5A5\uC774 \uBC18\uB300\uC774\uC9C0\uB9CC
    \uC11C\uB85C \uB2E4\uB978 \uBB3C\uCCB4\uC5D0 \uC791\uC6A9\uD558\uBBC0\uB85C \uC11C\uB85C
    \uC0C1\uC1C4\uB418\uC9C0 \uC54A\uB294\uB2E4."
  realPrinciple: "\uB274\uD134 \uC81C3\uBC95\uCE59(\uC791\uC6A9\xB7\uBC18\uC791\uC6A9):
    \uBB3C\uCCB4 A\uAC00 B\uC5D0 \uD798\uC744 \uAC00\uD558\uBA74 B\uB3C4 A\uC5D0
    \uD06C\uAE30\uAC00 \uAC19\uACE0 \uBC29\uD5A5\uC774 \uBC18\uB300\uC778 \uD798\uC744
    \uAC00\uD55C\uB2E4. \uD55C \uBB3C\uCCB4\uC5D0 \uC791\uC6A9\uD558\uB294 \uB450
    \uD798\uC774 \uD3C9\uD615\uC744 \uC774\uB8E8\uB294 \uAC83\uACFC\uB294 \uB2E4\uB974\uB2E4."
  sourceRef: "\uC911\uD559\uAD50 \uACFC\uD559 \u2014 \uD798\uC758 \uC791\uC6A9\uACFC
    \uB274\uD134 \uC6B4\uB3D9 \uBC95\uCE59"
  conceptQuestions:
  - question: "\uB2E4\uC74C \uC911 \uC791\uC6A9\xB7\uBC18\uC791\uC6A9 \uAD00\uACC4\uC5D0
      \uB300\uD55C \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uC740?"
    choices:
    - "\uD06C\uAE30\uAC00 \uAC19\uACE0 \uBC29\uD5A5\uC774 \uBC18\uB300\uC774\uBA70
      \uC11C\uB85C \uB2E4\uB978 \uBB3C\uCCB4\uC5D0 \uC791\uC6A9\uD55C\uB2E4"
    - "\uD06C\uAE30\uAC00 \uAC19\uACE0 \uBC29\uD5A5\uC774 \uBC18\uB300\uC774\uBA70
      \uAC19\uC740 \uBB3C\uCCB4\uC5D0 \uC791\uC6A9\uD574 \uD569\uB825\uC774 0\uC774
      \uB41C\uB2E4"
    - "\uC791\uC6A9\uC774 \uBC18\uC791\uC6A9\uBCF4\uB2E4 \uD56D\uC0C1 \uB354 \uD06C\uB2E4"
    - "\uB450 \uD798\uC740 \uAC19\uC740 \uBC29\uD5A5\uC73C\uB85C \uC791\uC6A9\uD55C\uB2E4"
    answerIndex: 0
  - question: "\uB2E4\uC74C \uC911 \uC811\uCD09\uD55C \uB450 \uBA74 \uC0AC\uC774\uC5D0\uC11C
      \uBB3C\uCCB4\uC758 \uC6B4\uB3D9\uC744 \uBC29\uD574\uD558\uB294 \uD798\uC740?"
    choices:
    - "\uB9C8\uCC30\uB825"
    - "\uBD80\uB825"
    - "\uB9CC\uC720\uC778\uB825"
    - "\uD0C4\uC131\uB825"
    answerIndex: 0
  affinityQuestions:
  - question: "\uBCBD\uC744 \uC138\uAC8C \uBC00\uBA74 \uB0B4 \uC190\uB3C4 \uC544\uD504\uB2E4.
      \uADF8 \uC774\uC720\uB294?"
    choices:
    - "\uBCBD\uB3C4 \uB098\uB97C \uAC19\uC740 \uD06C\uAE30\uC758 \uD798\uC73C\uB85C
      \uBC00\uAE30 \uB54C\uBB38\uC774\uB2E4"
    - "\uBCBD\uC774 \uB2E8\uB2E8\uD574\uC11C \uD798\uC774 \uC804\uB2EC\uB418\uC9C0
      \uC54A\uAE30 \uB54C\uBB38\uC774\uB2E4"
    conceptPick: 0
