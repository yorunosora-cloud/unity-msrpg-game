  personality: "\uC785\uC790\uC131 \u2014 \uC2B9\uBD80\uC695 \uAC15\uD55C \uC6B4\uB3D9\uC120\uC218
    \uAE30\uC9C8 / \uD30C\uB3D9\uC131 \u2014 \uBC1D\uACE0 \uC5D0\uB108\uC9C0 \uB118\uCE58\uB294
    \uCE58\uC5B4\uB9AC\uB354 \uAE30\uC9C8"
  basicAttackMotion: "\uC785\uC790\uC131 \u2014 \uD22C\uAD6C \uD3FC / \uD30C\uB3D9\uC131
    \u2014 \uCE58\uC5B4\uB9AC\uB529 \uB3D9\uC791\uC73C\uB85C \uBE5B \uBC29\uCD9C"
  basicExplanation: "\uBE5B\uC740 \uD30C\uB3D9\uCC98\uB7FC \uAC04\uC12D\uACFC \uD68C\uC808\uC744
    \uC77C\uC73C\uD0A4\uB294 \uC131\uC9C8\uACFC, \uC785\uC790\uCC98\uB7FC \uC5D0\uB108\uC9C0\uB97C
    \uC54C\uAC31\uC774(\uAD11\uC790) \uB2E8\uC704\uB85C \uC8FC\uACE0\uBC1B\uB294
    \uC131\uC9C8\uC744 \uBAA8\uB450 \uAC00\uC9C4\uB2E4. \uC774\uB97C \uBE5B\uC758
    \uC774\uC911\uC131\uC774\uB77C\uACE0 \uD55C\uB2E4."
  advancedExplanation: "\uAD11\uC804 \uD6A8\uACFC\uC5D0\uC11C\uB294 \uAE08\uC18D\uC5D0
    \uBE5B\uC744 \uBE44\uCD9C \uB54C \uBE5B\uC758 \uC9C4\uB3D9\uC218\uAC00 \uBB38\uD131
    \uC9C4\uB3D9\uC218 \uC774\uC0C1\uC774\uC5B4\uC57C \uC804\uC790\uAC00 \uD280\uC5B4\uB098\uC628\uB2E4.
    \uC9C4\uB3D9\uC218\uAC00 \uB0AE\uC73C\uBA74 \uBE5B\uC744 \uC544\uBB34\uB9AC \uC138\uAC8C
    \uBE44\uCDB0\uB3C4 \uC804\uC790\uAC00 \uB098\uC624\uC9C0 \uC54A\uB294\uB2E4.
    \uC774\uB294 \uBE5B\uC774 E = hf\uC758 \uC5D0\uB108\uC9C0\uB97C \uAC00\uC9C4
    \uAD11\uC790\uB85C \uC5D0\uB108\uC9C0\uB97C \uC804\uB2EC\uD558\uAE30 \uB54C\uBB38\uC774\uB2E4.
    \uBC18\uBA74 \uC774\uC911 \uC2AC\uB9BF \uC2E4\uD5D8\uC758 \uAC04\uC12D\uBB34\uB2AC\uB294
    \uBE5B\uC758 \uD30C\uB3D9\uC131\uC744 \uBCF4\uC5EC \uC900\uB2E4."
  realPrinciple: "\uAD11\uC790 1\uAC1C\uC758 \uC5D0\uB108\uC9C0\uB294 E = hf (h\uB294
    \uD50C\uB791\uD06C \uC0C1\uC218, f\uB294 \uC9C4\uB3D9\uC218)\uC774\uB2E4. \uAD11\uC804
    \uD6A8\uACFC\uB294 \uC544\uC778\uC288\uD0C0\uC778\uC774 \uAD11\uC591\uC790\uC124\uB85C
    \uC124\uBA85\uD588\uB2E4."
  sourceRef: "\uACE0\uB4F1\uD559\uAD50 \uBB3C\uB9AC\uD559 \u2014 \uBE5B\uACFC \uBB3C\uC9C8\uC758
    \uC774\uC911\uC131"
  conceptQuestions:
  - question: "\uAD11\uC804 \uD6A8\uACFC\uC5D0\uC11C \uAE08\uC18D \uD45C\uBA74\uC5D0\uC11C
      \uC804\uC790\uAC00 \uD280\uC5B4\uB098\uC624\uB294\uC9C0\uB97C \uACB0\uC815\uD558\uB294
      \uAC83\uC740?"
    choices:
    - "\uBE5B\uC758 \uC138\uAE30(\uBC1D\uAE30)\uB9CC\uC73C\uB85C \uACB0\uC815\uB41C\uB2E4"
    - "\uBE5B\uC758 \uC9C4\uB3D9\uC218\uAC00 \uBB38\uD131 \uC9C4\uB3D9\uC218 \uC774\uC0C1\uC778\uC9C0\uB85C
      \uACB0\uC815\uB41C\uB2E4"
    - "\uBE5B\uC744 \uCB10\uB294 \uC2DC\uAC04\uC73C\uB85C \uACB0\uC815\uB41C\uB2E4"
    - "\uAE08\uC18D\uC758 \uBD80\uD53C\uB85C \uACB0\uC815\uB41C\uB2E4"
    answerIndex: 1
  affinityQuestions:
  - question: "\uBE5B\uC740 \uC785\uC790\uC77C\uAE4C, \uD30C\uB3D9\uC77C\uAE4C?"
    choices:
    - "\uB458 \uB2E4 \uB9DE\uB2E4. \uC0C1\uD669\uC5D0 \uB530\uB77C \uB2E4\uB974\uAC8C
      \uB4DC\uB7EC\uB09C\uB2E4"
    - "\uB458 \uC911 \uD558\uB098\uB9CC \uB9DE\uB2E4"
    conceptPick: 0
