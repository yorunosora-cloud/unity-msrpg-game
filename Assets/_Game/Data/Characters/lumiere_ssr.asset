  dexNumber: 0
  gender: 0
  concept: "\uC785\uC790\uC131=\uC6B4\uB3D9\uC120\uC218(\uD22C\uC218), \uD30C\uB3D9\uC131=\uCE58\uC5B4\uB9AC\uB354"
  appearance: "\uC785\uC790\uC131: \uC57C\uAD6C \uC120\uC218(\uD22C\uC218). \uD55C
    \uC190\uC5D4 \uAE00\uB7EC\uBE0C, \uB2E4\uB978 \uC190\uC5D4 \uAD11\uC790(\uB178\uB780
    \uACF5). \uC57C\uAD6C \uCEA1, \uC0DB\uB178\uB780 \uAE08\uBC1C, \uC5F0\uB450\uC0C9
    \uB208\uB3D9\uC790. \uD770\uC0C9 \uC57C\uAD6C \uC720\uB2C8\uD3FC. / \uD30C\uB3D9\uC131:
    \uBBF8\uAD6D \uD558\uC774\uD2F4 \uCE58\uC5B4\uB9AC\uB354 \uC2A4\uD0C0\uC77C.
    \uD5C8\uB9AC\uAE4C\uC9C0 \uC624\uB294 \uAE08\uBC1C. \uD770 \uD06C\uB86D\uD2F0+\uC9E7\uC740
    \uCE58\uB9C8. \uBCFC\uC5D0 \uC0DB\uBCC4 \uBAA8\uC591 \uB178\uB780 \uD0C0\uD22C.
    \uD478\uB978 \uB208\uB3D9\uC790."
  weapon: "\uC785\uC790\uC131 \u2014 \uAE00\uB7EC\uBE0C, \uAD11\uC790(\uACF5) / \uD30C\uB3D9\uC131
    \u2014 \uCE58\uC5B4\uB9AC\uB529 \uB3C4\uAD6C"
  loreKo: "\uC2B9\uBD80\uC695 \uAC15\uD55C \uD22C\uC218\uC640 \uBC1D\uC740 \uCE58\uC5B4\uB9AC\uB354\uAC00
    \uD558\uB098\uC758 \uBAB8\uC5D0 \uAE43\uB4E0 \uC774\uC911\uC758 \uC874\uC7AC\uB2E4.
    \uC5B4\uB290 \uCABD\uC774 \uC9C4\uC9DC\uB0D0\uB294 \uBB3C\uC74C\uC5D0 \uB458
    \uB2E4\uB77C\uACE0 \uB2F5\uD558\uACE0\uB294 \uC6C3\uC5B4 \uBC84\uB9B0\uB2E4."
