  concept: "\uC2DC\uAC04 \uAD00\uB9AC\uAD6D \uC9C1\uC6D0. 25\uC138 \uC815\uB3C4\uC758
    \uC678\uD615\uC758 \uBBF8\uC18C\uB144"
  appearance: "\uD0DC\uC5FD \uC2DC\uACC4 \uC0C9\uC758 \uC815\uC7A5\uACFC \uC704\uB85C
    \uD070 \uC6D0\uD1B5\uD615 \uBAA8\uC790. \uB179\uC0C9 \uB2E8\uBC1C, \uC678\uC548\uACBD(\uD55C\uCABD\uB9CC
    \uC788\uB294 \uC904\uB2EC\uB9B0 \uC548\uACBD), \uD68C\uC911\uC2DC\uACC4 \uC18C\uC9C0.
    \uC544\uB798\uAC00 \uB113\uC740 \uD1B5\uBC14\uC9C0. \uD314\uB2E4\uB9AC\uAC00
    \uAE38\uACE0 \uBE44\uC728\uC774 \uC88B\uC73C\uBA70 \uC6C3\uB294 \uC5BC\uAD74."
  weapon: "\uD68C\uC911\uC2DC\uACC4\uC758 \uC2DC\uCE68\xB7\uBD84\uCE68\xB7\uCD08\uCE68"
  loreKo: "\uC81C\uAD6D \uC2DC\uAC04 \uAD00\uB9AC\uAD6D\uC758 \uC2E0\uC0AC\uC801\uC778
    \uC9C1\uC6D0\uC73C\uB85C, \uC81C\uAD6D\uC758 \uBAA8\uB4E0 \uC2DC\uACC4\uB97C
    \uD55C \uCE58\uC758 \uC624\uCC28 \uC5C6\uC774 \uB9DE\uCD94\uB294 \uAC83\uC774
    \uC5C5\uBB34\uB2E4. \uB2E4\uB9CC \uADF8\uC758 \uD68C\uC911\uC2DC\uACC4\uB9CC\uC740
    \uAC00\uB054 \uC544\uC8FC \uC870\uAE08 \uB290\uB9AC\uAC8C \uAC00\uB294\uB370,
    \uADF8\uB294 \uC6C3\uC73C\uBA70 \"\uACE0\uC7A5\uC774 \uC544\uB2D9\uB2C8\uB2E4\"\uB77C\uACE0\uB9CC
    \uB2F5\uD55C\uB2E4."
