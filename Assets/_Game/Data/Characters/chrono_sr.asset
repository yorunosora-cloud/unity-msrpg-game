  personality: "\uB9E4\uC0AC\uC5D0 \uC5EC\uC720\uB86D\uACE0 \uC2E0\uC0AC\uC801\uC774\uC9C0\uB9CC,
    \uC2DC\uAC04 \uC57D\uC18D\uC5D0\uB294 \uD55C \uCE58\uC758 \uC624\uCC28\uB3C4
    \uD5C8\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4"
  basicAttackMotion: "\uC190\uBAA9 \uC2A4\uB0C5\uC73C\uB85C \uC2DC\uACC4\uBC14\uB298\uC744
    \uC9E7\uAC8C \uCC0C\uB974\uB294 \uB3D9\uC791"
  basicExplanation: "\uC77C\uC0C1\uC5D0\uC11C \uC2DC\uAC04\uC740 \uB204\uAD6C\uC5D0\uAC8C\uB098
    \uB611\uAC19\uC774 \uD750\uB974\uB294 \uAC83\uCC98\uB7FC \uB290\uAEF4\uC9C0\uC9C0\uB9CC,
    \uD2B9\uC218\uC0C1\uB300\uC131\uC774\uB860\uC5D0 \uB530\uB974\uBA74 \uAD00\uCC30\uC790\uC758
    \uC6B4\uB3D9 \uC0C1\uD0DC\uC5D0 \uB530\uB77C \uB2E4\uB974\uAC8C \uCE21\uC815\uB41C\uB2E4.
    \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294 \uC2DC\uACC4\uB294 \uC815\uC9C0\uD55C
    \uAD00\uCC30\uC790\uAC00 \uBCF4\uAE30\uC5D0 \uB354 \uB290\uB9AC\uAC8C \uAC04\uB2E4.
    \uC774\uB97C \uC2DC\uAC04 \uC9C0\uC5F0\uC774\uB77C\uACE0 \uD55C\uB2E4."
  advancedExplanation: "\uC6C0\uC9C1\uC774\uB294 \uC2DC\uACC4\uC758 \uACBD\uACFC
    \uC2DC\uAC04\uC740 \uC815\uC9C0\uD55C \uAD00\uCC30\uC790\uAC00 \uBCFC \uB54C
    \u03B3\uBC30\uB85C \uB298\uC5B4\uB09C\uB2E4. \u03B3 = 1/\u221A(1\u2212(v/c)\xB2)
    \uC774\uBA70 v\uB294 \uC18D\uB825, c\uB294 \uBE5B\uC758 \uC18D\uB825\uC774\uB2E4.
    v\uAC00 c\uC5D0 \uBE44\uD574 \uB9E4\uC6B0 \uC791\uC73C\uBA74 \u03B3 \u2248 1\uC774\uC5B4\uC11C
    \uB274\uD134 \uC5ED\uD559\uC758 \uC808\uB300 \uC2DC\uAC04\uACFC \uAC70\uC758
    \uAC19\uB2E4. \uC18D\uB825\uC774 \uBE5B\uC758 95%\uC774\uBA74 \u03B3 \u2248 3.2\uAC00
    \uB41C\uB2E4."
  realPrinciple: "\uC2DC\uAC04 \uC9C0\uC5F0\uC740 \uBAA8\uB4E0 \uAD00\uC131\uACC4\uC5D0\uC11C
    \uBE5B\uC758 \uC18D\uB825\uC774 \uAC19\uB2E4\uB294 \uC6D0\uB9AC\uB85C\uBD80\uD130
    \uC720\uB3C4\uB41C\uB2E4. \uB300\uAE30 \uC0C1\uCE35\uC5D0\uC11C \uC0DD\uAE34
    \uBBA4\uC628\uC774 \uC218\uBA85\uC774 \uC9E7\uC740\uB370\uB3C4 \uC9C0\uD45C\uBA74\uAE4C\uC9C0
    \uB3C4\uB2EC\uD558\uB294 \uD604\uC0C1\uC774 \uB300\uD45C\uC801\uC778 \uC99D\uAC70\uC774\uB2E4."
  sourceRef: "\uACE0\uB4F1\uD559\uAD50 \uBB3C\uB9AC\uD559 \u2014 \uD2B9\uC218 \uC0C1\uB300\uC131
    \uC774\uB860"
  conceptQuestions:
  - question: "\uD2B9\uC218\uC0C1\uB300\uC131\uC774\uB860\uC758 \uC2DC\uAC04 \uC9C0\uC5F0\uC5D0
      \uB300\uD55C \uC124\uBA85\uC73C\uB85C \uC633\uC740 \uAC83\uC740?"
    choices:
    - "\uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294 \uC2DC\uACC4\uB294 \uC815\uC9C0\uD55C
      \uAD00\uCC30\uC790\uAC00 \uBCF4\uAE30\uC5D0 \uB354 \uB290\uB9AC\uAC8C \uAC04\uB2E4"
    - "\uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294 \uC2DC\uACC4\uB294 \uC815\uC9C0\uD55C
      \uAD00\uCC30\uC790\uAC00 \uBCF4\uAE30\uC5D0 \uB354 \uBE60\uB974\uAC8C \uAC04\uB2E4"
    - "\uC18D\uB825\uACFC \uAD00\uACC4\uC5C6\uC774 \uBAA8\uB4E0 \uC2DC\uACC4\uAC00
      \uD56D\uC0C1 \uAC19\uC740 \uBE60\uB974\uAE30\uB85C \uAC04\uB2E4"
    - "\uC2DC\uAC04 \uC9C0\uC5F0\uC740 \uC911\uB825\uC774 \uC5C6\uC744 \uB54C\uB9CC
      \uB098\uD0C0\uB09C\uB2E4"
    answerIndex: 0
  affinityQuestions:
  - question: "\uC2DC\uAC04\uC740 \uBAA8\uB450\uC5D0\uAC8C \uB611\uAC19\uC774 \uD750\uB97C\uAE4C?"
    choices:
    - "\uC544\uB2C8\uB2E4. \uC6B4\uB3D9 \uC0C1\uD0DC\uC5D0 \uB530\uB77C \uB2E4\uB974\uAC8C
      \uCE21\uC815\uB41C\uB2E4"
    - "\uADF8\uB807\uB2E4. \uC5B8\uC81C\uB098 \uB204\uAD6C\uC5D0\uAC8C\uB098 \uB611\uAC19\uB2E4"
    conceptPick: 0
